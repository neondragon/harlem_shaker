# System
.DS_Store

# Editors
.idea/
.vscode/
*.swp
*.swo

# Secrets — never commit
.env
.env.*
!.env.example
secrets.toml
secrets.json

# Note: .claude/ is intentionally NOT listed here.
# It's governed by .claude/.gitignore (default-deny with explicit
# whitelisting), which only works if .claude/ itself isn't ignored
# at repo root.

# Audio is a local build input only — never commit it as a file.
# It ships solely inlined (base64) in the built bookmarklet/page.
*.mp3
*.ogg
*.opus
*.m4a
*.wav

# --- Build artifacts: uncomment the block(s) for this project's stack ---

# Rust
# target/
# # Cargo.lock: commit for bins, ignore for libs
# # Cargo.lock

# Node / TypeScript (uncomment if Code picks a Node build script)
# node_modules/
# *.tsbuildinfo

# Python
# __pycache__/
# *.py[cod]
# .venv/
# venv/
# build/
# dist/
# *.egg-info/
# .pytest_cache/
# .mypy_cache/
# .ruff_cache/

# Go
# bin/
# # go.sum: usually commit; uncomment only if intentional

# Swift / Xcode
# .build/
# DerivedData/
# *.xcworkspace/xcuserdata/
# *.xcodeproj/xcuserdata/
